# Somente valores não secretos. Use Key Vault/OIDC nos ambientes Fabric.
RADAR_ENVIRONMENT=local
RADAR_CONFIG_DIR=config
RADAR__STREAMING__BOOTSTRAP_SERVERS=localhost:19092
RADAR__STREAMING__TOPIC=delivery-events-v1

# Identificadores não secretos usados pelo deployment Fabric.
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# FABRIC_TOKEN é temporário e nunca deve ser persistido neste arquivo.
