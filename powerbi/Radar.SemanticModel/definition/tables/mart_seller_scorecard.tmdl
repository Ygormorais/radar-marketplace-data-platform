table mart_seller_scorecard
	lineageTag: 5acba145-bf48-45f0-bb58-417ac1598c76

	measure 'GMV vendedor' = SUM(mart_seller_scorecard[gmv])
		formatString: "R$ #,0.00;\"-R$ #,0.00\";R$ #,0.00"

	measure 'Pedidos vendedor' = SUM(mart_seller_scorecard[order_count])
		formatString: #,0

	measure 'SLA vendedor %' = DIVIDE(SUMX(mart_seller_scorecard, mart_seller_scorecard[on_time_delivery_rate] * mart_seller_scorecard[order_count]), [Pedidos vendedor])
		formatString: 0.0%;-0.0%;0.0%

	column seller_key
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: seller_key

	column order_count
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: order_count

	column gmv
		dataType: decimal
		formatString: "R$ #,0.00"
		summarizeBy: sum
		sourceColumn: gmv

	column average_delay_days
		dataType: decimal
		formatString: 0.00
		summarizeBy: average
		sourceColumn: average_delay_days

	column on_time_delivery_rate
		dataType: decimal
		formatString: 0.0%
		summarizeBy: average
		sourceColumn: on_time_delivery_rate

	partition mart_seller_scorecard = entity
		mode: directLake
		source
			entityName: mart_seller_scorecard
			schemaName: mart
			expressionSource: DatabaseQuery

